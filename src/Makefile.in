# VPATH and shell configuration
top_srcdir = @top_srcdir@
srcdir     = @srcdir@
VPATH      = @srcdir@
SHELL      = /bin/sh

# Installation targets
#
prefix      = @prefix@
exec_prefix = @exec_prefix@
datarootdir = @datarootdir@
bindir      = @bindir@
libdir      = @libdir@
includedir  = @includedir@
mandir      = @mandir@
docdir      = @docdir@
pdfdir      = @pdfdir@
mandir      = @mandir@
man1dir     = ${mandir}/man1
man1ext     = .1

CC             = @CC@
CFLAGS         = @CFLAGS@
PTHREAD_CFLAGS = @PTHREAD_CFLAGS@
PIC_CFLAGS     = @PIC_CFLAGS@
NEON_CFLAGS    = @NEON_CFLAGS@
SSE_CFLAGS     = @SSE_CFLAGS@
VMX_CFLAGS     = @VMX_CFLAGS@
CPPFLAGS       = @CPPFLAGS@
LDFLAGS        = @LDFLAGS@
DEFS           = @DEFS@
LIBS           = -lhmmer -leasel -ldivsufsort  @LIBS@ @LIBGSL@ @PTHREAD_LIBS@ ${PZ_LIBS} -lm

AR        = @AR@
OBJCOPY   ?= objcopy
RANLIB    = @RANLIB@
STRIP     = @STRIP@
INSTALL   = @INSTALL@

IMPLDIR   = impl_@IMPL_CHOICE@
ESLDIR    = @HMMER_ESLDIR@
SADIR     = @HMMER_SADIR@

# PEZY-SC (PZCL) offload
#
# Detected at build time.  Override the SDK location with PZSDK_PATH=... ,
# the device generation with PZ_ARCH=... (only sc3 has been tested), or
# disable the offload entirely with HMMER_NO_PEZY=1.
#
PZSDK_PATH ?= /opt/pezy/pzsdk
PZ_ARCH    ?= sc3
# Depending on the SDK version, the headers are under include/ or inc/.  Look
# for the header itself rather than assuming a directory name: when this
# guessed wrong, PZ_FOUND just went empty and the build silently produced a
# CPU-only binary that still passed every correctness test.
PZ_HDR     := $(firstword $(wildcard $(PZSDK_PATH)/include/pzcl/pzcl.h $(PZSDK_PATH)/inc/pzcl/pzcl.h))
PZ_INCDIR  := $(patsubst %/pzcl/pzcl.h,%,$(PZ_HDR))
PZ_FOUND   := $(shell test -x $(PZSDK_PATH)/bin/pzcc -a -r "$(PZ_HDR)" -a -r $(PZSDK_PATH)/lib/libpzcl.so && echo yes)
ifdef HMMER_NO_PEZY
PZ_FOUND   :=
endif
ifeq ($(PZ_FOUND),yes)
PZ_CFLAGS   = -DHAVE_PEZY -I$(PZ_INCDIR)
PZ_LIBS     = -L$(PZSDK_PATH)/lib -lpzcl -lstdc++ -Wl,-rpath,$(PZSDK_PATH)/lib
PZ_OBJS     = p7_pz.o p7_pzdb.o p7_pzscan.o p7_pz_kernel_pz.o
PZ_PROGS    = pz_ssv_utest pz_pzdb_utest pz_ssvmulti_utest pz_fpprobe_utest pz_fwdparse_utest pz_bwprobe_utest
endif

# Git commit the binary is built from, shown on the -h help page.
#
# Captured here rather than by ./configure, so that it tracks the working
# tree at *compile* time and not at configure time.  GIT_DIRTY only looks at
# tracked files: the build itself drops generated files into the tree, and
# those must not make every build look modified.
#
# A source tree distributed without .git has no repository of its own, and
# may well sit inside some other repository whose HEAD would be the wrong
# answer.  Such a tree carries the commit (with -dirty already applied) in
# ${top_srcdir}/GIT_COMMIT, and when that file is there it wins over git.
GIT         ?= git
GIT_STAMP   := $(wildcard ${top_srcdir}/GIT_COMMIT)
ifneq ($(GIT_STAMP),)
GIT_COMMIT  := $(shell head -n 1 $(GIT_STAMP))
GIT_DIRTY   :=
else
GIT_COMMIT  := $(shell cd ${top_srcdir} 2>/dev/null && $(GIT) rev-parse --short=12 HEAD 2>/dev/null || echo unknown)
GIT_DIRTY   := $(shell cd ${top_srcdir} 2>/dev/null && $(GIT) diff --quiet HEAD -- 2>/dev/null || echo -dirty)
endif

MYLIBDIRS = -L../${ESLDIR} -L./${IMPLDIR} -L../${SADIR} -L.
MYINCDIRS = -I../${ESLDIR} \
	    -I${top_srcdir}/easel \
	    -I. \
	    -I${srcdir} \
	    -I../${SADIR} 

